# for OSX, uncomment the following:

# ACE's C relies on GNU nested functions throughout; Apple's clang (aliased
# as /usr/bin/gcc) cannot compile them at all, even with -fnested-functions.
# This must resolve to Homebrew's real GCC (`brew install gcc`), not Apple's.
CC=$(shell ls $$(brew --prefix gcc)/bin/gcc-[0-9]* 2>/dev/null | sort -V | tail -1)
CXX=$(shell ls $$(brew --prefix gcc)/bin/g++-[0-9]* 2>/dev/null | sort -V | tail -1)
CFLAGS+=-m64 -DMACOSX_GCC
POST_LIBS=-lutil
BOOST_CFLAGS=-I $(shell brew --prefix boost)/include
# Homebrew's boost is built against libc++, not libstdc++ (even though CC
# above is real GCC, not clang) -- must link its C++ runtime, not GCC's own.
BOOST_REGEX_LIBS=$(shell brew --prefix boost)/lib/libboost_regex.a -lc++
DELPHIN_CFLAGS=
DELPHIN_LIBS=
POST_LIBS=-lutil
EXPORT_DYNAMIC_CFLAG=
SONAME_FLAG=-Wl,-install_name,libace.so
